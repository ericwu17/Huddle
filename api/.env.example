# Names only; copy to api/.env (ignored) and fill in. Exported values win.
HUDDLE_SHARED_SECRET=
# true: synthetic fixtures (phase zero). false: real solver over data/places.json.
# The module's STUB_MODE must match, or the API rejects its place IDs.
STUB_MODE=
# Optional; defaults to api/fixtures/places.fake.json (stub) or data/places.json (real).
PLACES_PATH=
# Real mode only. Without a key, parsing uses keyword rules and the council falls back to Safe.
ANTHROPIC_API_KEY=
CLAUDE_MODEL_FAST=claude-haiku-5-5
CLAUDE_MODEL_SMART=claude-sonnet-5-5
# Real mode, optional: stream council messages to the module as they are validated.
SPACETIMEDB_URI=
SPACETIMEDB_DB=

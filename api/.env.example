# Names only; copy to api/.env (ignored) and fill in. Exported values win.
HUDDLE_SHARED_SECRET=
# Optional; defaults to data/places.json.
PLACES_PATH=
# Without a key, parsing uses keyword rules and the council falls back to Safe.
ANTHROPIC_API_KEY=
CLAUDE_MODEL_FAST=claude-haiku-5-5
CLAUDE_MODEL_SMART=claude-haiku-5-5
# Optional: stream council messages to the module as they are validated.
SPACETIMEDB_URI=
SPACETIMEDB_DB=
# Optional real connectors. These remain unavailable until explicitly configured.
# Mac-only iMessage adapter, with recipient opt-in enforced in Maincloud.
HUDDLE_MESSAGES_ENABLED=false
# Google OAuth web client; enable Google Calendar API and allow the exact callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Generate a Fernet key locally; keep it stable and private so saved tokens decrypt.
HUDDLE_CONNECTOR_ENCRYPTION_KEY=
# Browser frontend origin used only for the fixed /connectors callback return.
HUDDLE_FRONTEND_BASE_URL=

# Optional targeted Mac Contacts lookup; enable only on the designated host.
HUDDLE_MAC_CONTACTS_ENABLED=false

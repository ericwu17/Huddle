# Copy to .env.local and fill in. Never commit real values.
# Same names as the repo's .env.example (vite.config.ts accepts the NEXT_PUBLIC_ prefix).
# Local SpacetimeDB: `spacetime start`, then publish server/ as huddle-dev (see ../README.md).
NEXT_PUBLIC_SPACETIMEDB_URI=ws://127.0.0.1:3000
NEXT_PUBLIC_SPACETIMEDB_DB=huddle-dev
# Optional free Google Maps Embed API key, restricted to Maps Embed API + website origins.
# Displays directions/time inside Google Maps. Without it: venue pins + straight-line distances.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

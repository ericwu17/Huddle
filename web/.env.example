# Copy to .env.local and fill in. Never commit real values.
# Same names as the repo's .env.example (vite.config.ts accepts the NEXT_PUBLIC_ prefix).
# Local SpacetimeDB: `spacetime start`, then publish server/ as huddle-dev (see ../README.md).
NEXT_PUBLIC_SPACETIMEDB_URI=ws://127.0.0.1:3000
NEXT_PUBLIC_SPACETIMEDB_DB=huddle-dev
# Public app URL used in join links and QR codes. Set it to the production domain
# (https://huddle-two-neon.vercel.app) so links never point at a one-off deployment.
NEXT_PUBLIC_APP_URL=
# Mapbox public token (pk.*). Optional: without it the map is a plain SVG plot.
NEXT_PUBLIC_MAPBOX_TOKEN=

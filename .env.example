# Names only. Real values go in .env / .env.local (gitignored).
# The SpacetimeDB module declares its own env keys (server/src/schema.ts) and reads them from
# your shell when you run `spacetime publish`.

# Shared by the SpacetimeDB module, api, voice (header X-Huddle-Secret)
HUDDLE_SHARED_SECRET=

# SpacetimeDB (local: http://127.0.0.1:3000 and huddle-local; later Maincloud)
# api and voice POST to {SPACETIMEDB_URI}/v1/database/{SPACETIMEDB_DB}/route/...
SPACETIMEDB_URI=
SPACETIMEDB_DB=
NEXT_PUBLIC_SPACETIMEDB_URI=
NEXT_PUBLIC_SPACETIMEDB_DB=

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_TOKEN=

# Service URLs / data
FASTAPI_BASE_URL=
VOICE_BASE_URL=
PLACES_PATH=

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL_FAST=claude-haiku-5-5
CLAUDE_MODEL_SMART=claude-sonnet-5-5

# Data sources
GOOGLE_PLACES_API_KEY=
# Bright Data Web Scraper API (data/reviews/collect.py, docs/BRIGHTDATA.md): the key only, no zone
BRIGHTDATA_API_KEY=
# Optional: a Web Unlocker zone name, for fetching venue menu pages (collect.py details)
BRIGHTDATA_UNLOCKER_ZONE=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEMO_RESTAURANT_PHONE=
ALLOW_REAL_CALLS=false

# Voice
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
STT_PROVIDER=cartesia
STT_API_KEY=
AGENT_LANGUAGE=zh

# Flags
COUNCIL_ENABLED=true
STUB_MODE=true
